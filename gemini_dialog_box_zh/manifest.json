{
  "manifest_version": 3,
  "name": "Gemini 对话框导航器 (Gemini Dialog Box)",
  "version": "1.0.0",
  "description": "在 Google Gemini 对话页面右侧生成历史提问目录，支持平滑跳转、快捷键上下切换与关键词搜索。",
  "permissions": [],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini_dialog_box.js"
      ],
      "run_at": "document_idle"
    }
  ]
}